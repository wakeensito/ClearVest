{
  "name": "@clearvest/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "npx --yes @stoplight/prism-cli@5 mock ../docs/api/openapi.yaml",
    "gen:api": "openapi-typescript ../docs/api/openapi.yaml -o src/api/schema.d.ts",
    "lint": "eslint .",
    "typecheck": "npm run gen:api && tsc -b",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "node scripts/browser-smoke.cjs",
    "test:history-refresh": "node scripts/history-refresh-smoke.cjs",
    "test:fund-explainer": "node scripts/fund-explainer-smoke.cjs",
    "test:security-search": "node scripts/security-search-smoke.cjs",
    "test:markets-advisor": "node scripts/markets-advisor-smoke.cjs",
    "test:portfolio-xray": "node scripts/portfolio-xray-smoke.cjs",
    "test:explain": "node scripts/explain-terms-smoke.cjs",
    "test:scout": "node scripts/scout-smoke.cjs",
    "test:scout-actions": "node scripts/scout-actions-smoke.cjs",
    "test:scout-safety": "node scripts/scout-safety-smoke.cjs",
    "test:scout-workspace": "node scripts/scout-workspace-smoke.cjs",
    "test:scout-voice": "node scripts/scout-voice-smoke.cjs",
    "test:scout-ownership": "node scripts/scout-ownership-smoke.cjs",
    "test:scout-learning": "node scripts/scout-learning-smoke.cjs",
    "test:bundle": "node scripts/bundle-smoke.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.48.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plaid-link": "^5.0.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
