# Copy to .env.local. Defaults to the Prism mock (npm run mock) when unset.
# For the real backend use the stack's ApiUrl output (docs/api/README.md), no trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:4010

# The backend is Plaid-sandbox-only, so the site offers "Use a sample account" (no Plaid popup,
# phone number or code). Set to false once real Plaid accounts are supported.
VITE_PLAID_SANDBOX=true
